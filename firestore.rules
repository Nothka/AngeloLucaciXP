rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasOnly(['name', 'rating', 'comment', 'approved', 'createdAt']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 40 &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        request.resource.data.comment is string &&
        request.resource.data.comment.size() >= 3 &&
        request.resource.data.comment.size() <= 500 &&
        request.resource.data.approved == true;
      allow update, delete: if false;
    }

    // Blockvale: each browser signs in anonymously and can only touch its own player saves.
    match /blockvale/{uid}/worlds/{worldId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if
        request.auth != null &&
        request.auth.uid == uid &&
        worldId.size() <= 64 &&
        request.resource.data.keys().hasOnly(['name', 'seed', 'mode', 'savedAt', 'player']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() <= 64 &&
        request.resource.data.seed is number &&
        request.resource.data.mode in ['survival', 'creative'] &&
        request.resource.data.savedAt is number &&
        request.resource.data.player is map &&
        request.resource.data.player.keys().hasOnly(['pos', 'yaw', 'pitch', 'flying', 'selected', 'inventory', 'armor', 'xp', 'vitals']) &&
        request.resource.data.player.inventory is list &&
        request.resource.data.player.inventory.size() <= 36 &&
        request.resource.data.player.armor is list &&
        request.resource.data.player.armor.size() <= 4;
    }

    // Blockvale multiplayer matchmaking: a host publishes a room under a code; a joining
    // player posts one connection offer, the host posts one answer. Rooms can't be listed:
    // you need the code. Nothing else about the game goes through Firestore.
    match /rooms/{code} {
      allow get: if request.auth != null;
      allow create: if
        request.auth != null &&
        code.size() == 6 &&
        request.resource.data.keys().hasOnly(['host', 'name', 'seed', 'version', 'createdAt']) &&
        request.resource.data.host == request.auth.uid &&
        request.resource.data.name is string &&
        request.resource.data.name.size() <= 64 &&
        request.resource.data.seed is number &&
        request.resource.data.version is number;
      allow delete: if request.auth != null && resource.data.host == request.auth.uid;

      match /joins/{uid} {
        function isHost() {
          return get(/databases/$(database)/documents/rooms/$(code)).data.host == request.auth.uid;
        }
        allow get: if request.auth != null && (request.auth.uid == uid || isHost());
        allow list: if request.auth != null && isHost();
        allow create: if
          request.auth != null &&
          request.auth.uid == uid &&
          exists(/databases/$(database)/documents/rooms/$(code)) &&
          request.resource.data.keys().hasOnly(['name', 'offer', 'createdAt']) &&
          request.resource.data.name is string &&
          request.resource.data.name.size() <= 24 &&
          request.resource.data.offer is string &&
          request.resource.data.offer.size() <= 20000;
        allow update: if
          request.auth != null &&
          isHost() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer', 'error']) &&
          (!('answer' in request.resource.data) || (request.resource.data.answer is string && request.resource.data.answer.size() <= 20000)) &&
          (!('error' in request.resource.data) || (request.resource.data.error is string && request.resource.data.error.size() <= 200));
        allow delete: if request.auth != null && (request.auth.uid == uid || isHost());
      }
    }

    match /projectLikes/{projectId} {
      allow read: if projectId in ['portfolio', 'applewebsite'];
      allow create: if
        projectId in ['portfolio', 'applewebsite'] &&
        request.resource.data.keys().hasOnly(['count', 'updatedAt']) &&
        request.resource.data.count == 1 &&
        request.resource.data.updatedAt == request.time;
      allow update: if
        projectId in ['portfolio', 'applewebsite'] &&
        request.resource.data.keys().hasOnly(['count', 'updatedAt']) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'updatedAt']) &&
        request.resource.data.count is int &&
        request.resource.data.count >= 0 &&
        (
          request.resource.data.count == resource.data.count + 1 ||
          request.resource.data.count == resource.data.count - 1
        ) &&
        request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
  }
}
